{
    "name": "9in/laravel-server",
    "description": "Keep your users in your Laravel database and sign them in with 9in: adapter protocol v2 endpoints (authenticate, user, event) for Eloquent.",
    "keywords": [
        "9in",
        "sso",
        "laravel",
        "oauth2",
        "openid-connect",
        "adapter",
        "authentication"
    ],
    "homepage": "https://9in.io",
    "license": "MIT",
    "authors": [
        {
            "name": "9in",
            "email": "support@9in.io"
        },
        {
            "name": "Cubelet Ltd.",
            "homepage": "https://cubelet.co.uk"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0",
        "9in/php-sdk": "^3.0",
        "9in/laravel-events": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.11",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nine\\Laravel\\Server\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nine\\Laravel\\Server\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nine\\Laravel\\Server\\ServerServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-master": "3.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-fixer": "php-cs-fixer fix"
    }
}
